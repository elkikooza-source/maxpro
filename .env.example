# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Server-Side Configuration (optional — resilient SQLite fallback activates automatically)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=maxpro-media

# Admin Passcode Override (optional — if unset, first-run setup flow lets you claim a password in /admin)
ADMIN_PASSCODE=
